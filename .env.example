# Supabase is OPTIONAL. Without these keys the app runs in device-local mode:
# all records are stored in this browser's localStorage only (no sync).
# To enable cross-device sync, create a Supabase project, run
# supabase/migrations/0001_finance.sql, and fill these in (see README.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
